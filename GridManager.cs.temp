    [Header("Scoring")]
    public int pointsPerLine = 100;
    public int comboMultiplier = 10;
    [SerializeField] private int streakBonusBase = 50; // Base points for maintaining a streak
    [SerializeField] private int streakExponent = 2; // Exponential growth of streak bonus
    [SerializeField] private float streakTimeWindow = 15f; // Time window to maintain streak (seconds)
    [SerializeField] private int maxDisplayedStreak = 10; // Maximum streak to display visually
    private int currentStreak = 0; // Current streak counter
    private float streakTimer = 0f; // Timer to track streak expiration
    
    // VFX for streaks and combos
    [Header("Visual Feedback")]
    [SerializeField] private GameObject streakTextPrefab; // Text popup for streaks
    [SerializeField] private GameObject lineCompletionVFXPrefab; // Optional particle effect for line completion
    [SerializeField] private Color[] streakColors; // Array of colors for increasing streak levels
    
    [Header("Player Assistance")]
